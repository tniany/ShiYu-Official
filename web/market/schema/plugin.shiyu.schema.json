{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-shiy.tniay.top/market/schema/plugin.shiyu.schema.json",
  "title": "时遇插件 shiyu.json",
  "description": "插件只能调用 App 已实现并审核的接口，不能包含可执行代码、脚本、远程加载器或宿主能力。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "id",
    "version",
    "name",
    "summary",
    "description",
    "author",
    "category",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "plugin"
    },
    "id": {
      "type": "string",
      "pattern": "^community\\.[a-z][a-z0-9-]{2,47}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]{1,32})?$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "icon": {
      "enum": [
        "schedule",
        "music",
        "search",
        "travel",
        "extension"
      ],
      "default": "extension"
    },
    "capabilities": {
      "description": "只能声明 App 已实现并审核的接口，不能填写任意权限或可执行能力。",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "time",
          "music",
          "web_search",
          "travel_guidance"
        ]
      }
    },
    "permissions": {
      "description": "数据流向补充说明。已审核接口的标准说明由时遇自动加入。",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "settings": {
      "description": "声明式设置，最多 12 项。key 和 target 必须唯一，default 必须与 capabilities 生成的 runtimePrefs 基线一致。",
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/pluginSetting"
      }
    }
  },
  "$defs": {
    "pluginSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "label",
        "target",
        "default"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,31}$"
        },
        "type": {
          "const": "switch"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 180
        },
        "target": {
          "description": "只能绑定 capabilities 自动生成的已审核运行时字段。",
          "enum": [
            "agent_time_enabled",
            "agent_music_enabled",
            "web_search_enabled",
            "agent_travel_enabled"
          ]
        },
        "default": {
          "const": true
        }
      }
    }
  }
}

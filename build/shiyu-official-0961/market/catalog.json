  "plugins": [
    {
      "id": "official.time-tools",
      "name": "日期与时间",
      "summary": "让角色知道今天的日期、星期、时间和设备时区。",
      "description": "官方内置工具包。模型只在问题确实需要时读取本机时间，数据不会上传到额外服务。",

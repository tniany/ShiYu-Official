      "version": "1.1.0",
      "category": "实用工具",
      "icon": "schedule",
      "permissions": ["读取本机当前日期、时间和时区"],
      "runtimePrefs": {"agent_time_enabled": true}
    },
    {
      "id": "official.netease-music",
      "name": "网易云点歌",
      "summary": "查询真实歌曲、分享播放链接，并接入一起听歌。",
      "description": "官方内置音乐工具。角色可以按歌名或歌手搜索网易云音乐；播放仍受版权、登录和第三方服务状态限制。",
      "author": "时遇官方",
      "version": "1.2.0",
      "category": "娱乐内容",
      "icon": "music",
      "permissions": ["向网易云音乐公共接口发送歌曲关键词", "打开已安装的音乐应用"],
      "runtimePrefs": {"agent_music_enabled": true}
    },
    {
      "id": "official.live-web-search",
      "name": "实时联网搜索",
      "summary": "需要最新信息时调用必应搜索，再把真实结果交还给角色。",
      "description": "官方内置搜索能力。每轮最多搜索两次，搜索词会发送给已配置的搜索服务，输出仍可能包含第三方资料中的错误。",
      "author": "时遇官方",
      "version": "1.3.0",
      "category": "信息检索",
      "icon": "search",
      "permissions": ["将搜索关键词发送至必应或自定义搜索服务", "读取公开网页摘要"],
      "runtimePrefs": {"web_search_enabled": true}
    },
    {
      "id": "official.travel-assistant",
      "name": "出行助手",
      "summary": "协助整理地点、时间和路线，并按配置调用地图、天气或叫车工具。",
      "description": "官方工具提示包。没有配置远程服务时只能帮助打开对应 App；涉及叫车、费用和位置的操作仍需逐次确认。",
      "author": "时遇官方",
      "version": "1.0.0",
      "category": "生活服务",
      "icon": "travel",
      "permissions": ["调用已配置的天气、地图与出行 MCP 工具", "在需要时提示打开第三方出行应用"],
      "runtimePrefs": {"agent_travel_enabled": true}
    },
    {
      "id": "official.group-director",
      "name": "群聊导演",
      "summary": "为多角色群聊提供接话、沉默和结束回合的测试版能力。",
      "description": "为新建群聊启用角色自主接话、话题开启和默认接话倾向；现有群聊仍可在聊天设置中单独调整。",
      "author": "时遇官方",
      "version": "0.9.0-beta",
      "category": "实验功能",
      "icon": "groups",
      "permissions": ["为新建群聊设置角色自主接话", "允许角色按倾向决定是否接话", "允许角色在冷场时开启话题"],
      "runtimePrefs": {"default_group_reply_decision": true, "default_group_autonomous": true, "default_group_topics": true, "default_group_probability": 70},
      "experimental": true
    }
